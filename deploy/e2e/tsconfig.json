{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["playwright.config.ts", "src/**/*.ts", "tests/**/*.ts"]
}
